# Copy to .env and fill in what you have. Every provider is optional;
# providers whose keys are missing are skipped automatically.

# Storage (SQLite by default; Postgres: postgresql+psycopg://user:pass@host/db)
PF_DATABASE_URL=sqlite:///./data/pricefinder.db

# Default home location used for local/in-store search and tax estimates
PF_HOME_POSTAL_CODE=
PF_HOME_COUNTRY=US
PF_DEFAULT_CURRENCY=USD

# eBay Browse API (https://developer.ebay.com)
PF_EBAY_CLIENT_ID=
PF_EBAY_CLIENT_SECRET=

# SerpApi (Google Shopping / Flights / Hotels) (https://serpapi.com)
PF_SERPAPI_KEY=

# Best Buy Developer API (https://developer.bestbuy.com) - products + in-store availability
PF_BESTBUY_API_KEY=

# Walmart Affiliate API (https://walmart.io) - consumer id + RSA private key PEM
PF_WALMART_CONSUMER_ID=
PF_WALMART_PRIVATE_KEY_PATH=
PF_WALMART_KEY_VERSION=1

# LLM-backed query understanding (optional). PF_QUERY_PARSER: auto | rules | llm
PF_ANTHROPIC_API_KEY=
PF_QUERY_PARSER=auto
PF_LLM_MODEL=claude-opus-5-5

# Radius for in-store results
PF_LOCAL_RADIUS_KM=40

# Networking
PF_HTTP_TIMEOUT_SECONDS=20
PF_PROVIDER_TIMEOUT_SECONDS=30
PF_MAX_CONCURRENT_PROVIDERS=8
